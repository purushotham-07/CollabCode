# ==============================================================================
# CollabCode Frontend Environment Variables Template
# Copy this file to .env before starting the frontend Vite dev server
# ==============================================================================

# Backend API Base URL (empty or /api in development with Vite proxy)
VITE_API_BASE_URL=/api

# Backend Proxy Target for Vite dev server (defaults to http://localhost:8080)
VITE_BACKEND_PROXY_URL=http://localhost:8080
