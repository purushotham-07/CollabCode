# ------------------------------------------------------------------------------
# CollabCode Environment Variables Template
# Copy this file to .env before starting the services
# ------------------------------------------------------------------------------

# Application
APP_ENV=development
SERVER_PORT=8080
FRONTEND_PORT=3000

# Security / JWT
# Key generation: 2048-bit RSA PEM or auto-generated if left empty
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000       # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000   # 7 days

# Database - MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=collabcode
MONGO_URI=mongodb://admin:password@mongo:27017/collabcode?authSource=admin&replicaSet=rs0

# Cache & Distribution - Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=collabcode_redis_secret

# Google OAuth2 Credentials
# Leave empty to test email/password auth without Google OAuth configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/callback

# Nginx / Frontend URLs
VITE_API_BASE_URL=http://localhost/api
VITE_WS_BASE_URL=ws://localhost/ws
