# ==============================================================================
# CollabCode Backend Environment Variables Template
# Copy this file to .env before starting the backend service
# ==============================================================================

# Server
PORT=8080
SERVER_PORT=8080

# Database - MongoDB (Local or Atlas)
MONGO_URI=mongodb://localhost:27017/collabcode
# Atlas Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.pgzrziu.mongodb.net/collabcode?retryWrites=true&w=majority

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security / JWT
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Google OAuth2 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
